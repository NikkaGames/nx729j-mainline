		};

	};
};

&tlmm {
	gpio-reserved-ranges = <36 4>;

	bt_default: bt-default-state {
		bt-en-pins {
			pins = "gpio81";
			function = "gpio";
			drive-strength = <16>;
			bias-disable;
		};

		sw-ctrl-pins {
			pins = "gpio82";
			function = "gpio";
			bias-pull-down;
		};
	};

	wlan_en: wlan-en-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	wcd_default: wcd-reset-n-active-state {
		pins = "gpio108";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};
};

&pm8010_n {
	status = "disabled";
};

&gpi_dma1 {
	status = "okay";
};

&gpi_dma2 {
	status = "okay";
};

&gpu {
	status = "disabled";

	/*zap-shader {
		firmware-name = "qcom/sm8550/nx729j/a740_zap.mbn";
	};*/
};

&pm8550b_eusb2_repeater {
	vdd18-supply = <&pm_humu_l15>;
	vdd3-supply = <&pm_humu_l5>;
};

&i2c_master_hub_0 {
	status = "okay";
};

&i2c_hub_2 {
	status = "okay";

	typec-mux@42 {
		compatible = "fcs,fsa4480";
		reg = <0x42>;

		vcc-supply = <&pm_humu_bob1>;

		mode-switch;
		orientation-switch;

		port {
			fsa4480_sbu_mux: endpoint {
				remote-endpoint = <&pmic_glink_sbu>;
			};
		};
	};
};

&dispcc {
	status = "disabled";
};

&mdss {
	status = "disabled";
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 210 GPIO_ACTIVE_LOW>;
	vcc-supply = <&pm_humu_l17>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&pm_v6g_l1>;
	vccq-max-microamp = <1200000>;
	vdd-hba-supply = <&pm_v6g_l3>;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&pm_v6d_l1>;
	vdda-pll-supply = <&pm_v6e_l3>;

	status = "okay";
};

&usb_1 {
	status = "okay";
};

&usb_1_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in>;
};

&usb_1_hsphy {
	vdd-supply = <&pm_v6e_l1>;
	vdda12-supply = <&pm_v6e_l3>;

	phys = <&pm8550b_eusb2_repeater>;

	status = "okay";
};

&usb_dp_qmpphy {
	vdda-phy-supply = <&pm_v6e_l3>;
	vdda-pll-supply = <&pm_v8_l3>;

	status = "okay";
};